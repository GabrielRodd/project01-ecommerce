# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Clerk (authentication) — copy this block to `.env.local`.
# Keys are available in the Clerk Dashboard > API keys.
# The publishable key is public (sent to the browser); the secret key must NEVER be exposed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
